{
  "name": "@enclave-technologies/auth-sdk",
  "version": "0.1.0",
  "description": "Post-quantum client/domain cryptography for Enclave Auth",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./init": {
      "types": "./dist/init.d.ts",
      "import": "./dist/init.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./challenge": {
      "types": "./dist/challenge.d.ts",
      "import": "./dist/challenge.js"
    },
    "./session-token": {
      "types": "./dist/session-token.d.ts",
      "import": "./dist/session-token.js"
    },
    "./session-verify": {
      "types": "./dist/session-verify.d.ts",
      "import": "./dist/session-verify.js"
    },
    "./migration": {
      "types": "./dist/migration/orchestrator.d.ts",
      "import": "./dist/migration/orchestrator.js"
    },
    "./migration/types": {
      "types": "./dist/migration/types.d.ts",
      "import": "./dist/migration/types.js"
    },
    "./amk": {
      "types": "./dist/amk/index.d.ts",
      "import": "./dist/amk/index.js"
    },
    "./account": {
      "types": "./dist/account/index.d.ts",
      "import": "./dist/account/index.js"
    },
    "./password-policy": {
      "types": "./dist/password-policy.d.ts",
      "import": "./dist/password-policy.js"
    },
    "./pin-policy": {
      "types": "./dist/pin-policy.d.ts",
      "import": "./dist/pin-policy.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@enclave-technologies/pqc-primitives": "^0.1.0",
    "@scure/bip39": "^1.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Enclave-Auth/enclave-auth-sdk"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
